# ---------------------------------------------------------------------------
# AutoDev CI — environment configuration
#
# Copy to `.env.local` and fill in what you need. Every variable below is
# OPTIONAL: with an empty file the platform still boots and runs in
# "self-contained mode" — in-memory storage, deterministic analysis engine,
# dev authentication. Add credentials to progressively unlock features.
#
# Validation lives in `src/core/env.ts`. Invalid values fail fast at startup.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public origin of the deployment. Used for webhook URLs and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# `development` | `test` | `production` (usually set by the host)
# NODE_ENV="development"
# `debug` | `info` | `warn` | `error`
LOG_LEVEL="info"

# --- Database (PostgreSQL / Supabase) ---------------------------------------
# When unset, AutoDev CI uses an in-memory store. Great for evaluation and
# tests; nothing is persisted across restarts.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/autodev"
# Supabase pooled connections need SSL and a lower pool size:
# DATABASE_SSL="require"
# DATABASE_POOL_MAX="10"

# --- Encryption -------------------------------------------------------------
# 32-byte key, base64 encoded. Required to persist GitHub tokens.
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=""

# --- GitHub App (recommended for production) --------------------------------
# Create at https://github.com/settings/apps/new — see README "GitHub App setup".
# GITHUB_APP_ID="123456"
# GITHUB_APP_CLIENT_ID="Iv1.abc123"
# GITHUB_APP_CLIENT_SECRET=""
# PEM contents with literal \n escapes, or a base64 blob of the PEM.
# GITHUB_APP_PRIVATE_KEY=""
# Shared secret configured on the GitHub App webhook.
# GITHUB_WEBHOOK_SECRET=""

# --- GitHub PAT (development fallback) --------------------------------------
# Scopes: repo, read:org. Used when no App credentials are present.
# GITHUB_TOKEN=""

# --- Authentication (Clerk) -------------------------------------------------
# When unset, a local development identity is used and dashboard auth is open.
# Never deploy to production without configuring a real auth provider.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""

# --- AI (OpenRouter) --------------------------------------------------------
# `deterministic` runs the built-in offline analysis engine and costs nothing.
# `openrouter` layers LLM reasoning on top of the deterministic findings.
AUTODEV_AI_PROVIDER="deterministic"
# OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_FALLBACK_MODEL="openai/gpt-4.1-mini"
# Hard ceiling on tokens per single AI call.
AI_MAX_OUTPUT_TOKENS="4000"
# Abort an AI request after this many milliseconds.
AI_TIMEOUT_MS="60000"

# --- Background jobs (Trigger.dev) ------------------------------------------
# When unset, jobs run in-process on a local queue.
# TRIGGER_SECRET_KEY=""
# TRIGGER_PROJECT_ID=""

# --- Notifications ----------------------------------------------------------
# SLACK_WEBHOOK_URL=""
# TEAMS_WEBHOOK_URL=""
# GENERIC_WEBHOOK_URL=""
# SMTP transport for email notifications, e.g. smtp://user:pass@host:587
# SMTP_URL=""
# EMAIL_FROM="autodev@example.com"

# --- API access -------------------------------------------------------------
# Comma-separated list of bearer tokens accepted by the public REST API.
# Generate with: openssl rand -hex 32
# AUTODEV_API_KEYS=""
# Requests per minute, per API key or IP.
RATE_LIMIT_PER_MINUTE="60"
